{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Django Backend (SISTEMA_SALES)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/manage.py",
            "args": [
                "runserver",
                "127.0.0.1:8000"
            ],
            "django": true,
            "justMyCode": true,
            "env": {
                "PYTHONUNBUFFERED": "1",
                "DB_ENGINE": "mysql"
            }
        },
        {
            "name": "Python: Cargar Semillas en MySQL (seed_data)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/manage.py",
            "args": [
                "seed_data"
            ],
            "django": true
        },
        {
            "name": "Frontend: Abrir en Chrome",
            "type": "chrome",
            "request": "launch",
            "file": "${workspaceFolder}/frontend/index.html"
        }
    ]
}
